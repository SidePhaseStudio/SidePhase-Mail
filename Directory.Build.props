<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>SidePhase Studio</Company>
    <Product>SidePhase Mail</Product>
    <Copyright>Copyright © 2026 SidePhase Studio</Copyright>
    <!-- One version for the app, its assemblies and the MSIX package (Package.appxmanifest Identity Version must be
         VersionPrefix + ".0"; a test checks it). Beta builds use VersionSuffix "beta.N"; CI adds the source revision
         to the informational version (e.g. 0.7.0-beta.1+3f2a9c...). -->
    <VersionPrefix>0.7.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <Authors>SidePhase Studio</Authors>
    <Deterministic>true</Deterministic>
    <!-- Public Desktop client ID owned by SidePhase Studio. Set once before distribution; see GOOGLE_SETUP.md. -->
    <SidePhaseGoogleClientId Condition="'$(SidePhaseGoogleClientId)' == ''">14204421377-2b4le3jpgfr1amirfrh4eampelo8lodl.apps.googleusercontent.com</SidePhaseGoogleClientId>
    <!-- Public native Microsoft registration for personal and work/school accounts; no client secret. -->
    <SidePhaseMicrosoftClientId Condition="'$(SidePhaseMicrosoftClientId)' == ''">cff3a5ae-ddc3-4688-a1e7-9ee28ba2b868</SidePhaseMicrosoftClientId>
  </PropertyGroup>
  <!-- Publisher-only Desktop registration value; never a user's tokens or a confidential web-client secret. -->
  <Import Project="$(MSBuildThisFileDirectory)GoogleOAuth.local.props" Condition="Exists('$(MSBuildThisFileDirectory)GoogleOAuth.local.props')" />
</Project>
