<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>SidePhase.Mail.App</RootNamespace>
    <AssemblyName>SidePhaseMail</AssemblyName>
    <AssemblyTitle>SidePhase Mail</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>

    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Program.cs provides Main (single instance + activation redirection). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Two ways to build (see docs/PACKAGING.md):
       * Portable (default): unpackaged + self-contained. The output folder runs by double-clicking SidePhaseMail.exe,
         with no install, Windows App SDK runtime installer or .NET runtime needed. Data: %LOCALAPPDATA%\SidePhase Mail.
       * MSIX (-p:SidePhasePackage=msix): the installed / Microsoft Store app with package identity. Depends on the
         Windows App Runtime framework package (installed by the Store, or from the Dependencies folder when
         sideloading); .NET is still bundled. Data: the package's LocalState folder. -->
  <PropertyGroup Condition="'$(SidePhasePackage)' != 'msix'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SidePhasePackage)' == 'msix'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode Condition="'$(UapAppxPackageBuildMode)' == ''">SideloadOnly</UapAppxPackageBuildMode>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
    <AppxPackageDir Condition="'$(AppxPackageDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\msix\</AppxPackageDir>
    <!-- Unsigned unless a certificate is supplied (never committed; see docs/PACKAGING.md#signing). -->
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateThumbprint)' == '' and '$(PackageCertificateKeyFile)' == ''">false</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateThumbprint)' != '' or '$(PackageCertificateKeyFile)' != ''">true</AppxPackageSigningEnabled>
  </PropertyGroup>

  <!-- Pick the runtime identifier from the platform so Visual Studio (x64/ARM64) and the CLI both work. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SidePhase.Mail.Core\SidePhase.Mail.Core.csproj" />
    <ProjectReference Include="..\SidePhase.Mail.Infrastructure\SidePhase.Mail.Infrastructure.csproj" />
  </ItemGroup>

</Project>
