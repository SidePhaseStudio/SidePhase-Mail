<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SidePhase.Mail.App.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SidePhase.Mail.App.Helpers"
    xmlns:vm="using:SidePhase.Mail.App.ViewModels"
    Background="Transparent">

  <Page.Resources>
    <DataTemplate x:Key="ContactTemplate" x:DataType="vm:ContactItemViewModel">
      <Grid Padding="12,10" Background="{ThemeResource SpCardBrush}" ColumnSpacing="14" CornerRadius="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="36" Height="36" VerticalAlignment="Center">
          <Ellipse Fill="{x:Bind h:X.AvatarBrush(AvatarIndex)}" />
          <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontFamily="{StaticResource SpSmallFont}"
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="White"
              Text="{x:Bind Initials}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind SourceText}" />
          </StackPanel>
          <TextBlock IsTextSelectionEnabled="True" MaxLines="2" Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind EmailsText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
          <Button
              AutomationProperties.Name="Write email"
              Command="{x:Bind WriteCommand}"
              IsEnabled="{x:Bind CanWrite}"
              Style="{StaticResource SpQuickActionButtonStyle}"
              ToolTipService.ToolTip="Write email">
            <FontIcon FontSize="13" Glyph="&#xE715;" />
          </Button>
          <Button AutomationProperties.Name="Edit" Command="{x:Bind EditCommand}" Style="{StaticResource SpQuickActionButtonStyle}" ToolTipService.ToolTip="Edit">
            <FontIcon FontSize="13" Glyph="&#xE70F;" />
          </Button>
          <Button AutomationProperties.Name="Delete" Command="{x:Bind DeleteCommand}" Style="{StaticResource SpQuickActionButtonStyle}" ToolTipService.ToolTip="Delete">
            <FontIcon FontSize="13" Glyph="&#xE74D;" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource SpPanelStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Padding="36,26,36,10" Spacing="10">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="2">
          <TextBlock FontSize="28" Style="{StaticResource SpTitleTextStyle}" Text="Contacts" />
          <TextBlock Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Center" Click="OnImportClick" Style="{StaticResource SpSecondaryButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE8B5;" />
            <TextBlock Text="Import vCard…" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.AddCommand}" Style="{StaticResource SpPrimaryButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE8FA;" />
            <TextBlock Text="New contact" />
          </StackPanel>
        </Button>
      </Grid>
      <AutoSuggestBox
          AutomationProperties.Name="Search contacts"
          PlaceholderText="Search by name or address"
          QueryIcon="Find"
          Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
      <TextBlock Style="{StaticResource SpCaptionTextStyle}" Text="Contacts are kept on this PC only. People you send mail to are suggested automatically as you type." TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="36,0,36,24">
      <Grid>
        <ItemsRepeater ItemTemplate="{StaticResource ContactTemplate}" ItemsSource="{x:Bind ViewModel.Items}">
          <ItemsRepeater.Layout>
            <StackLayout Spacing="6" />
          </ItemsRepeater.Layout>
        </ItemsRepeater>
        <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
          <FontIcon FontSize="34" Foreground="{ThemeResource SpTextTertiaryBrush}" Glyph="&#xE716;" />
          <TextBlock HorizontalAlignment="Center" Style="{StaticResource SpSubtitleTextStyle}" Text="No contacts" />
          <TextBlock
              MaxWidth="380"
              HorizontalAlignment="Center"
              Style="{StaticResource SpSecondaryTextStyle}"
              Text="Add someone, or import a .vcf file exported from Outlook, Google Contacts or your phone."
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
