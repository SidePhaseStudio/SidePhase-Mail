<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SidePhase.Mail.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ads="using:SidePhase.Mail.App.Advertising"
    Title="SidePhase Mail">

  <Grid x:Name="RootGrid">

    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Backdrop layers: an opaque base for solid themes and a tint that deepens Mica towards the palette. -->
    <Border x:Name="SolidLayer" Grid.RowSpan="3" Background="{ThemeResource SpWindowSolidBrush}" />
    <Border Grid.RowSpan="3" Background="{ThemeResource SpWindowTintBrush}" />

    <!-- ============================ Title bar ============================ -->
    <TitleBar
        x:Name="AppTitleBar"
        Title="SidePhase Mail"
        Height="48"
        IsBackButtonVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneToggleRequested="OnPaneToggleRequested">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo.png" />
      </TitleBar.IconSource>
      <TitleBar.RightHeader>
        <Border
            Margin="0,0,12,0"
            Style="{StaticResource SpPillStyle}"
            Visibility="{x:Bind Shell.IsDemo, Mode=OneWay}">
          <TextBlock Style="{StaticResource SpPillTextStyle}" Text="DEMO DATA" />
        </Border>
      </TitleBar.RightHeader>
    </TitleBar>

    <!-- ============================ Sidebar + content ============================ -->
    <NavigationView
        x:Name="NavView"
        Grid.Row="1"
        CompactPaneLength="56"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="{x:Bind Shell.IsPaneOpen, Mode=TwoWay}"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="OnNavItemInvoked"
        OpenPaneLength="272"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavSelectionChanged">

      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="AttachmentsItem" Content="Attachments" Tag="attachments" ToolTipService.ToolTip="Find attachments">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE723;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="ContactsItem" Content="Contacts" Tag="contacts" ToolTipService.ToolTip="Contacts">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE716;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="AddAccountItem" Content="Add account" Tag="add-account" ToolTipService.ToolTip="Add account">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8FA;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>


      <!-- Pages float on the glass as rounded translucent panels (see SpPanelStyle); no hard frame border. -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Shown only while Windows reports no internet connection. -->
        <InfoBar
            x:Name="OfflineBar"
            Margin="0,0,8,8"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Message="Cached mail is still available. Drafts are saved on this PC and messages you send wait in the Outbox until you're back online."
            Severity="Warning"
            Title="You're offline" />
        <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0,0,8,8" />
      </Grid>
    </NavigationView>

    <!-- ============================ Footer promotion ============================ -->
    <!-- One centred banner (about 728 x 90) for approved SidePhase Studio promotions. Collapses completely when there's
         nothing to show (the default) or the window is short. Never inside the inbox or an email. -->
    <ads:PromotionFooter x:Name="Footer" Grid.Row="2" />

    <!-- ============================ Toasts ============================ -->
    <InfoBar
        x:Name="ToastBar"
        Grid.Row="1"
        MinWidth="320"
        MaxWidth="620"
        Margin="0,0,0,28"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Background="{ThemeResource SpAcrylicBrush}"
        BorderBrush="{ThemeResource SpStrokeStrongBrush}"
        CornerRadius="8"
        IsClosable="True"
        IsOpen="False">
      <InfoBar.ActionButton>
        <Button x:Name="ToastActionButton" Click="OnToastActionClick" Style="{StaticResource SpSecondaryButtonStyle}" />
      </InfoBar.ActionButton>
    </InfoBar>
  </Grid>
</Window>
