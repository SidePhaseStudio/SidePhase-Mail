<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SidePhase.Mail.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SidePhase.Mail.App.Helpers"
    xmlns:views="using:SidePhase.Mail.App.Views"
    xmlns:vm="using:SidePhase.Mail.App.ViewModels"
    Title="SidePhase Mail">

  <Grid x:Name="RootGrid">
    <Grid.Resources>
      <DataTemplate x:Key="NavItemTemplate" x:DataType="vm:NavItemViewModel">
        <NavigationViewItem
            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
            Content="{x:Bind Title}"
            ToolTipService.ToolTip="{x:Bind Title}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="{x:Bind Glyph}" />
          </NavigationViewItem.Icon>
          <NavigationViewItem.InfoBadge>
            <InfoBadge Style="{StaticResource SpInfoBadgeStyle}" Visibility="{x:Bind BadgeVisibility, Mode=OneWay}" Value="{x:Bind Count, Mode=OneWay}" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
      </DataTemplate>

      <DataTemplate x:Key="AccountTemplate" x:DataType="vm:NavItemViewModel">
        <NavigationViewItem
            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            MenuItemsSource="{x:Bind Children}"
            ToolTipService.ToolTip="{x:Bind Subtitle}">
          <NavigationViewItem.Icon>
            <FontIcon Foreground="{x:Bind h:X.HexBrush(ColorHex)}" Glyph="{x:Bind Glyph}" />
          </NavigationViewItem.Icon>
          <NavigationViewItem.Content>
            <StackPanel Spacing="0">
              <TextBlock MaxLines="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock
                  FontSize="11"
                  Foreground="{ThemeResource SpTextTertiaryBrush}"
                  MaxLines="1"
                  Text="{x:Bind Subtitle}"
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </NavigationViewItem.Content>
          <NavigationViewItem.InfoBadge>
            <InfoBadge Style="{StaticResource SpInfoBadgeStyle}" Visibility="{x:Bind BadgeVisibility, Mode=OneWay}" Value="{x:Bind Count, Mode=OneWay}" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
      </DataTemplate>

      <DataTemplate x:Key="HeaderTemplate" x:DataType="vm:NavItemViewModel">
        <NavigationViewItemHeader Content="{x:Bind Title}" />
      </DataTemplate>

      <DataTemplate x:Key="SeparatorTemplate" x:DataType="vm:NavItemViewModel">
        <NavigationViewItemSeparator />
      </DataTemplate>

      <views:NavItemTemplateSelector
          x:Key="NavTemplateSelector"
          AccountTemplate="{StaticResource AccountTemplate}"
          HeaderTemplate="{StaticResource HeaderTemplate}"
          ItemTemplate="{StaticResource NavItemTemplate}"
          SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Backdrop layers: an opaque base for solid themes and a tint that deepens Mica towards the palette. -->
    <Border x:Name="SolidLayer" Grid.RowSpan="2" Background="{ThemeResource SpWindowSolidBrush}" />
    <Border Grid.RowSpan="2" Background="{ThemeResource SpWindowTintBrush}" />

    <!-- ============================ Title bar ============================ -->
    <TitleBar
        x:Name="AppTitleBar"
        Title="SidePhase Mail"
        Height="48"
        IsBackButtonVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneToggleRequested="OnPaneToggleRequested">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo.png" />
      </TitleBar.IconSource>
      <TitleBar.RightHeader>
        <Border
            Margin="0,0,12,0"
            Style="{StaticResource SpPillStyle}"
            Visibility="{x:Bind Shell.IsDemo}">
          <TextBlock Style="{StaticResource SpPillTextStyle}" Text="DEMO DATA" />
        </Border>
      </TitleBar.RightHeader>
    </TitleBar>

    <!-- ============================ Sidebar + content ============================ -->
    <NavigationView
        x:Name="NavView"
        Grid.Row="1"
        CompactPaneLength="56"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="{x:Bind Shell.IsPaneOpen, Mode=TwoWay}"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="OnNavItemInvoked"
        MenuItemTemplateSelector="{StaticResource NavTemplateSelector}"
        MenuItemsSource="{x:Bind Shell.NavItems}"
        OpenPaneLength="272"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavSelectionChanged">

      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="AddAccountItem" Content="Add account" Tag="add-account" ToolTipService.ToolTip="Add account">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8FA;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid>
        <!-- Content layer: rounded top-left corner and a hairline edge where it meets the glass sidebar. -->
        <Border
            Background="Transparent"
            BorderBrush="{ThemeResource SpStrokeBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0" />
        <Frame x:Name="ContentFrame" Margin="1,1,0,0" CornerRadius="8,0,0,0" />
      </Grid>
    </NavigationView>

    <!-- ============================ Toasts ============================ -->
    <InfoBar
        x:Name="ToastBar"
        Grid.Row="1"
        MinWidth="320"
        MaxWidth="620"
        Margin="0,0,0,28"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Background="{ThemeResource SpElevatedBrush}"
        BorderBrush="{ThemeResource SpStrokeStrongBrush}"
        CornerRadius="10"
        IsClosable="True"
        IsOpen="False">
      <InfoBar.ActionButton>
        <Button x:Name="ToastActionButton" Click="OnToastActionClick" Style="{StaticResource SpSecondaryButtonStyle}" />
      </InfoBar.ActionButton>
    </InfoBar>
  </Grid>
</Window>
