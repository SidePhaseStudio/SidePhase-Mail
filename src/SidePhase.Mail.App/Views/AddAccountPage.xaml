<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SidePhase.Mail.App.Views.AddAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SidePhase.Mail.App.Helpers"
    Background="Transparent">

  <Grid Style="{StaticResource SpPanelStyle}">
    <ScrollViewer>
      <StackPanel
          MaxWidth="520"
          Margin="24,40"
          HorizontalAlignment="Center"
          Spacing="14">
        <StackPanel.ChildrenTransitions>
          <TransitionCollection>
            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
          </TransitionCollection>
        </StackPanel.ChildrenTransitions>

        <Button HorizontalAlignment="Left" Click="OnBackClick" Style="{StaticResource SpSubtleButtonStyle}" ToolTipService.ToolTip="Back">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="12" Glyph="&#xE72B;" />
            <TextBlock Text="Back" />
          </StackPanel>
        </Button>

        <TextBlock Style="{StaticResource SpTitleTextStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
        <TextBlock Style="{StaticResource SpSecondaryTextStyle}" TextWrapping="Wrap" Text="SidePhase Mail connects directly to your email provider. Your password or sign-in stays on this PC, encrypted with Windows, and is never sent to SidePhase Studio." />

        <!-- Step 1: who are you -->
        <Border Style="{StaticResource SpCardStyle}" Padding="20">
          <StackPanel Spacing="12">
            <TextBox
                x:Name="EmailBox"
                Header="Email address"
                InputScope="EmailSmtpAddress"
                IsEnabled="{x:Bind h:X.Not(ViewModel.IsBusy), Mode=OneWay}"
                IsSpellCheckEnabled="False"
                KeyDown="OnEmailKeyDown"
                PlaceholderText="name@example.com"
                Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                Header="Your name (shown to people you email)"
                IsEnabled="{x:Bind h:X.Not(ViewModel.IsBusy), Mode=OneWay}"
                PlaceholderText="e.g. Alex Morgan"
                Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ContinueCommand}"
                Content="Continue"
                Padding="16,10"
                Style="{StaticResource SpPrimaryButtonStyle}"
                Visibility="{x:Bind h:X.Collapsed(ViewModel.HasDiscovered), Mode=OneWay}" />
          </StackPanel>
        </Border>

        <!-- Step 2: sign in -->
        <Border Style="{StaticResource SpCardStyle}" Padding="20" Visibility="{x:Bind ViewModel.HasDiscovered, Mode=OneWay}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon FontSize="14" Foreground="{ThemeResource SpAccentTextBrush}" Glyph="&#xE715;" />
              <TextBlock Style="{StaticResource SpSecondaryTextStyle}" Text="{x:Bind ViewModel.ProviderText, Mode=OneWay}" />
            </StackPanel>

            <!-- OAuth -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowOAuthForm, Mode=OneWay}">
              <TextBlock Style="{StaticResource SpCaptionTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.OAuthUnavailableText, Mode=OneWay}" />
              <Button
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.SignInCommand}"
                  Content="{x:Bind ViewModel.OAuthButtonText, Mode=OneWay}"
                  IsEnabled="{x:Bind ViewModel.OAuthAvailable, Mode=OneWay}"
                  Padding="16,10"
                  Style="{StaticResource SpPrimaryButtonStyle}" />
              <HyperlinkButton
                  Command="{x:Bind ViewModel.UseAppPasswordCommand}"
                  Content="Use an app password instead"
                  Visibility="{x:Bind ViewModel.CanUseAppPassword, Mode=OneWay}" />
            </StackPanel>

            <!-- Password -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowPasswordForm, Mode=OneWay}">
              <PasswordBox
                  Header="Password"
                  IsEnabled="{x:Bind h:X.Not(ViewModel.IsBusy), Mode=OneWay}"
                  KeyDown="OnPasswordKeyDown"
                  Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
              <TextBlock
                  Style="{StaticResource SpCaptionTextStyle}"
                  Text="{x:Bind ViewModel.PasswordHint, Mode=OneWay}"
                  TextWrapping="Wrap"
                  Visibility="{x:Bind h:X.VisibleIfText(ViewModel.PasswordHint), Mode=OneWay}" />
              <Button
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.AddCommand}"
                  Content="Test and add account"
                  Padding="16,10"
                  Style="{StaticResource SpPrimaryButtonStyle}" />
            </StackPanel>

            <!-- Manual settings -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Server settings"
                IsExpanded="{x:Bind ViewModel.ShowServerSettings, Mode=TwoWay}">
              <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Header="Incoming (IMAP) server" IsSpellCheckEnabled="False" Text="{x:Bind ViewModel.ImapHost, Mode=TwoWay}" />
                <NumberBox Grid.Column="1" Header="Port" Maximum="65535" Minimum="1" Value="{x:Bind ViewModel.ImapPort, Mode=TwoWay}" />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" Header="Security" SelectedIndex="{x:Bind ViewModel.ImapSecurityIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="SSL/TLS" />
                  <ComboBoxItem Content="STARTTLS" />
                </ComboBox>

                <TextBox Grid.Row="1" Header="Outgoing (SMTP) server" IsSpellCheckEnabled="False" Text="{x:Bind ViewModel.SmtpHost, Mode=TwoWay}" />
                <NumberBox Grid.Row="1" Grid.Column="1" Header="Port" Maximum="65535" Minimum="1" Value="{x:Bind ViewModel.SmtpPort, Mode=TwoWay}" />
                <ComboBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Header="Security" SelectedIndex="{x:Bind ViewModel.SmtpSecurityIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="SSL/TLS" />
                  <ComboBoxItem Content="STARTTLS" />
                </ComboBox>

                <TextBox Grid.Row="2" Grid.ColumnSpan="3" Header="Username" IsSpellCheckEnabled="False" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource SpCaptionTextStyle}" TextWrapping="Wrap" Text="Only encrypted connections are offered. Certificates are checked by Windows; a connection is never downgraded to plain text." />
              </Grid>
            </Expander>

            <TextBlock Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind ViewModel.ImapResult, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind h:X.VisibleIfText(ViewModel.ImapResult), Mode=OneWay}" />
            <TextBlock Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind ViewModel.SmtpResult, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind h:X.VisibleIfText(ViewModel.SmtpResult), Mode=OneWay}" />
          </StackPanel>
        </Border>

        <!-- Status -->
        <Grid ColumnSpacing="12" Visibility="{x:Bind h:X.VisibleIfText(ViewModel.StatusText), Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
          <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE783;" Visibility="{x:Bind ViewModel.StatusIsError, Mode=OneWay}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SpSecondaryTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
          <Button Grid.Column="2" Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel" Style="{StaticResource SpSecondaryButtonStyle}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <HyperlinkButton Click="OnWorkAccountClick" Content="Using Microsoft 365 for work or school?" />
          <HyperlinkButton Click="OnThunderbirdClick" Content="Use settings from Thunderbird (beta)" ToolTipService.ToolTip="Fill in server settings from a Thunderbird profile. Passwords are never read." />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
