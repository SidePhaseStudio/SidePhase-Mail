<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SidePhase.Mail.App.Views.AttachmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SidePhase.Mail.App.ViewModels"
    Background="Transparent">

  <Page.Resources>
    <DataTemplate x:Key="HitTemplate" x:DataType="vm:AttachmentHitViewModel">
      <Grid Padding="12,8" Background="{ThemeResource SpCardBrush}" ColumnSpacing="12" CornerRadius="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource SpBadgeBrush}" CornerRadius="6">
          <FontIcon FontSize="16" Foreground="{ThemeResource SpBadgeTextBrush}" Glyph="{x:Bind Glyph}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock FontSize="13.5" MaxLines="1" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
          <TextBlock MaxLines="1" Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind Details}" TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="11.5" Foreground="{ThemeResource SpTextTertiaryBrush}" MaxLines="1" Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind DateText}" />
        <Button Grid.Column="3" VerticalAlignment="Center" Command="{x:Bind OpenCommand}" Content="Open email" Style="{StaticResource SpSecondaryButtonStyle}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource SpPanelStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Padding="36,26,36,10" Spacing="10">
      <TextBlock FontSize="28" Style="{StaticResource SpTitleTextStyle}" Text="Attachments" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <AutoSuggestBox AutomationProperties.Name="File name" PlaceholderText="File name" QueryIcon="Find" Text="{x:Bind ViewModel.FileName, Mode=TwoWay}" />
        <TextBox Grid.Column="1" AutomationProperties.Name="Sender" IsSpellCheckEnabled="False" PlaceholderText="Sender" Text="{x:Bind ViewModel.Sender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Type" ItemsSource="{x:Bind ViewModel.TypeOptions}" SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}" />
        <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" AutomationProperties.Name="Size" SelectedIndex="{x:Bind ViewModel.SizeIndex, Mode=TwoWay}">
          <ComboBoxItem Content="Any size" />
          <ComboBoxItem Content="Over 1 MB" />
          <ComboBoxItem Content="Over 5 MB" />
          <ComboBoxItem Content="Over 10 MB" />
          <ComboBoxItem Content="Over 25 MB" />
        </ComboBox>
        <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" AutomationProperties.Name="Received" SelectedIndex="{x:Bind ViewModel.PeriodIndex, Mode=TwoWay}">
          <ComboBoxItem Content="Any time" />
          <ComboBoxItem Content="Last week" />
          <ComboBoxItem Content="Last month" />
          <ComboBoxItem Content="Last 3 months" />
          <ComboBoxItem Content="Last year" />
        </ComboBox>
      </Grid>
      <TextBlock Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource SpCaptionTextStyle}" Opacity="0.8" Text="Uses the names and sizes your mail server reports, so nothing is downloaded to search. Files are never opened by SidePhase Mail." TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="36,0,36,24">
      <Grid>
        <ItemsRepeater ItemTemplate="{StaticResource HitTemplate}" ItemsSource="{x:Bind ViewModel.Results}">
          <ItemsRepeater.Layout>
            <StackLayout Spacing="6" />
          </ItemsRepeater.Layout>
        </ItemsRepeater>
        <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
          <FontIcon FontSize="34" Foreground="{ThemeResource SpTextTertiaryBrush}" Glyph="&#xE723;" />
          <TextBlock HorizontalAlignment="Center" Style="{StaticResource SpSubtitleTextStyle}" Text="No attachments found" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
