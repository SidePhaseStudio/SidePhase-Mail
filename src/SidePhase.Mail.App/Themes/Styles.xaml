<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SidePhase.Mail.App.Controls">

  <!-- ============================== Typography ============================== -->
  <Style x:Key="SpDisplayTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpDisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextPrimaryBrush}" />
    <Setter Property="TextLineBounds" Value="TrimToCapHeight" />
  </Style>

  <Style x:Key="SpTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpDisplayFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="SpSubtitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpDisplayFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextPrimaryBrush}" />
  </Style>

  <Style x:Key="SpBodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpTextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SpSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SpBodyTextStyle}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextSecondaryBrush}" />
  </Style>

  <Style x:Key="SpCaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpSmallFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SpSectionHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpTextFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="40" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextTertiaryBrush}" />
  </Style>

  <!-- ================================ Buttons ================================ -->
  <!-- Transparent button with a soft hover fill; used for toolbars and icon actions. -->
  <Style x:Key="SpSubtleButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource SpTextFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerMedium}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              AutomationProperties.AccessibilityView="Raw"
              Background="{TemplateBinding Background}"
              BackgroundSizing="{TemplateBinding BackgroundSizing}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              ContentTransitions="{TemplateBinding ContentTransitions}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Foreground="{TemplateBinding Foreground}"
              RenderTransformOrigin="0.5,0.5">
            <ContentPresenter.RenderTransform>
              <ScaleTransform x:Name="PresenterScale" />
            </ContentPresenter.RenderTransform>
            <ContentPresenter.BackgroundTransition>
              <BrushTransition Duration="0:0:0.083" />
            </ContentPresenter.BackgroundTransition>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PresenterScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.167" />
                    <DoubleAnimation Storyboard.TargetName="PresenterScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.167" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PresenterScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.167" />
                    <DoubleAnimation Storyboard.TargetName="PresenterScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.167" />
                  </Storyboard>
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SpTextPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PresenterScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.083" />
                    <DoubleAnimation Storyboard.TargetName="PresenterScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.083" />
                  </Storyboard>
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SpTextSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SpSubtleButtonStyle}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="SpQuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SpSubtleButtonStyle}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerSmall}" />
  </Style>

  <Style x:Key="SpToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SpSubtleButtonStyle}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0,12,0" />
    <Setter Property="Foreground" Value="{ThemeResource SpTextSubtleBrush}" />
  </Style>

  <Style x:Key="SpPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerMedium}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="SpSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerMedium}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ============================ Surfaces & pills ============================ -->
  <!-- Translucent glass panel used for the message list, reading pane and full-page views. -->
  <Style x:Key="SpPanelStyle" TargetType="Grid">
    <Setter Property="Background" Value="{ThemeResource SpPanelBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SpPanelStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerLarge}" />
  </Style>

  <!-- Groups related toolbar buttons on a faint shared surface. -->
  <Style x:Key="SpToolbarGroupStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SpControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerLarge}" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style x:Key="SpCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SpCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerLarge}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="SpPillStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SpBadgeBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2,8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SpPillTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpSmallFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource SpBadgeTextBrush}" />
  </Style>

  <Style x:Key="SpInfoBadgeStyle" TargetType="InfoBadge">
    <Setter Property="Background" Value="{ThemeResource SpBadgeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource SpBadgeTextBrush}" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="18" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="5,0" />
  </Style>

  <!-- ============================== List items ============================== -->
  <Style x:Key="SpMessageItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="Margin" Value="6,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerMedium}" />
  </Style>

  <!-- Section headers in the message list: no selection or hover visuals. -->
  <Style x:Key="SpListHeaderContainerStyle" TargetType="ListViewItem">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <ContentPresenter
              Margin="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================== Settings card ============================== -->
  <Style TargetType="controls:SettingsCard">
    <Setter Property="Background" Value="{ThemeResource SpCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpCornerLarge}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingsCard">
          <Grid
              MinHeight="{TemplateBinding MinHeight}"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              ColumnSpacing="16"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="IconElement"
                VerticalAlignment="Center"
                FontFamily="{StaticResource SpIconFont}"
                FontSize="18"
                Foreground="{ThemeResource SpTextSecondaryBrush}"
                Glyph="{TemplateBinding Glyph}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock
                  FontSize="14"
                  Foreground="{ThemeResource SpTextPrimaryBrush}"
                  Text="{TemplateBinding Header}"
                  TextWrapping="Wrap" />
              <TextBlock
                  x:Name="DescriptionText"
                  Style="{StaticResource SpCaptionTextStyle}"
                  Text="{TemplateBinding Description}" />
            </StackPanel>
            <ContentPresenter
                Grid.Column="2"
                MaxWidth="360"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================ Misc ================================ -->
  <Style x:Key="SpDividerStyle" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{ThemeResource SpDividerBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="SpVerticalDividerStyle" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Fill" Value="{ThemeResource SpStrokeBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
