<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SidePhase.Mail.App.Controls.ReadingPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ads="using:SidePhase.Mail.App.Advertising"
    xmlns:controls="using:SidePhase.Mail.App.Controls"
    xmlns:h="using:SidePhase.Mail.App.Helpers"
    xmlns:vm="using:SidePhase.Mail.App.ViewModels">

  <Grid>
    <!-- Empty state -->
    <StackPanel
        MaxWidth="340"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="10"
        Visibility="{x:Bind h:X.Collapsed(ViewModel.HasMessage), Mode=OneWay}">
      <Grid Width="140" Height="120" HorizontalAlignment="Center">
        <Ellipse Width="140" Height="120">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Offset="0" Color="#338B7CFF" />
              <GradientStop Offset="1" Color="#008B7CFF" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <controls:BrandMark Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      <TextBlock
          HorizontalAlignment="Center"
          Style="{StaticResource SpSubtitleTextStyle}"
          Text="Select a message to read" />
      <TextBlock
          HorizontalAlignment="Center"
          Style="{StaticResource SpSecondaryTextStyle}"
          Text="Tip: right-click any message to pin it to the top, star it, or move it to Junk."
          TextAlignment="Center" />
      <!-- Optional sponsored card, only while no message is open (never next to or inside an email). -->
      <ads:SponsoredCard Margin="0,28,0,0" Placement="EmptyReadingPane" />
    </StackPanel>

    <Grid x:Name="MessageView" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Toolbar -->
      <Grid Padding="14,12,14,4" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Style="{StaticResource SpToolbarGroupStyle}" Visibility="{x:Bind ViewModel.CanReply, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="0">
              <Button Command="{x:Bind ViewModel.ReplyCommand}" Style="{StaticResource SpToolbarButtonStyle}" ToolTipService.ToolTip="Reply (Ctrl+R)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontSize="15" Glyph="&#xE8CA;" />
                  <TextBlock Text="Reply" />
                </StackPanel>
              </Button>
              <Button Command="{x:Bind ViewModel.ReplyAllCommand}" Style="{StaticResource SpToolbarButtonStyle}" ToolTipService.ToolTip="Reply all (Ctrl+Shift+R)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontSize="15" Glyph="&#xE8C2;" />
                  <TextBlock Text="Reply all" />
                </StackPanel>
              </Button>
              <Button Command="{x:Bind ViewModel.ForwardCommand}" Style="{StaticResource SpToolbarButtonStyle}" ToolTipService.ToolTip="Forward (Ctrl+Shift+F)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontSize="15" Glyph="&#xE89C;" />
                  <TextBlock Text="Forward" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Button
              Command="{x:Bind ViewModel.EditDraftCommand}"
              Style="{StaticResource SpPrimaryButtonStyle}"
              Visibility="{x:Bind ViewModel.IsDraft, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontSize="14" Glyph="&#xE70F;" />
              <TextBlock Text="Continue editing" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource SpToolbarGroupStyle}">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button
                AutomationProperties.Name="Archive"
                Command="{x:Bind ViewModel.ArchiveCommand}"
                Style="{StaticResource SpIconButtonStyle}"
                ToolTipService.ToolTip="Archive">
              <FontIcon FontSize="15" Glyph="&#xE7B8;" />
            </Button>
            <Button
                AutomationProperties.Name="Delete"
                Command="{x:Bind ViewModel.DeleteCommand}"
                Style="{StaticResource SpIconButtonStyle}"
                ToolTipService.ToolTip="Delete (Del)">
              <FontIcon FontSize="15" Glyph="&#xE74D;" />
            </Button>
            <Rectangle Height="16" Margin="4,0" Style="{StaticResource SpVerticalDividerStyle}" />
            <Button
                AutomationProperties.Name="{x:Bind ViewModel.PinLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.TogglePinCommand}"
                Style="{StaticResource SpIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.PinLabel, Mode=OneWay}">
              <FontIcon FontSize="15" Glyph="{x:Bind ViewModel.PinGlyph, Mode=OneWay}" />
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind ViewModel.StarLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleStarCommand}"
                Style="{StaticResource SpIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.StarLabel, Mode=OneWay}">
              <FontIcon FontSize="15" Glyph="{x:Bind ViewModel.StarGlyph, Mode=OneWay}" />
            </Button>
            <Button AutomationProperties.Name="More actions" Style="{StaticResource SpIconButtonStyle}" ToolTipService.ToolTip="More actions">
              <FontIcon FontSize="15" Glyph="&#xE712;" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleReadCommand}" Text="{x:Bind ViewModel.ReadLabel, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8C3;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleJunkCommand}" Text="{x:Bind ViewModel.JunkLabel, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="{x:Bind ViewModel.JunkGlyph, Mode=OneWay}" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutSubItem Text="Snooze">
                    <MenuFlyoutSubItem.Icon>
                      <FontIcon Glyph="&#xE823;" />
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="LaterToday" Text="Later today" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="TomorrowMorning" Text="Tomorrow morning" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="ThisWeekend" Text="This weekend" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="NextWeek" Text="Next week" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="Custom" Text="Choose date and time…" />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SnoozeCommand}"
                        CommandParameter="Clear"
                        Text="Unsnooze"
                        Visibility="{x:Bind ViewModel.IsSnoozed, Mode=OneWay}" />
                  </MenuFlyoutSubItem>
                  <MenuFlyoutSubItem Text="Remind me to follow up">
                    <MenuFlyoutSubItem.Icon>
                      <FontIcon Glyph="&#xE7C1;" />
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.FollowUpCommand}" CommandParameter="Tomorrow" Text="Tomorrow" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.FollowUpCommand}" CommandParameter="InThreeDays" Text="In 3 days" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.FollowUpCommand}" CommandParameter="NextWeek" Text="Next week" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.FollowUpCommand}" CommandParameter="Custom" Text="Custom…" />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.FollowUpCommand}"
                        CommandParameter="Clear"
                        Text="Mark follow-up done"
                        Visibility="{x:Bind ViewModel.ShowFollowUpBanner, Mode=OneWay}" />
                  </MenuFlyoutSubItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Header -->
      <Grid x:Name="HeaderPanel" Grid.Row="1" Padding="28,14,28,2" RowSpacing="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontFamily="{StaticResource SpDisplayFont}"
            FontSize="22"
            FontWeight="SemiBold"
            Foreground="{ThemeResource SpTextPrimaryBrush}"
            IsTextSelectionEnabled="True"
            MaxLines="3"
            Text="{x:Bind ViewModel.Subject, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />

        <Grid Grid.Row="1" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid Width="40" Height="40" VerticalAlignment="Top">
            <Ellipse Fill="{x:Bind h:X.AvatarBrush(ViewModel.AvatarIndex), Mode=OneWay}" />
            <Ellipse Stroke="#1FFFFFFF" StrokeThickness="1" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{x:Bind ViewModel.Initials, Mode=OneWay}" />
          </Grid>

          <StackPanel Grid.Column="1" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock
                  FontSize="14"
                  FontWeight="SemiBold"
                  Foreground="{ThemeResource SpTextPrimaryBrush}"
                  IsTextSelectionEnabled="True"
                  Text="{x:Bind ViewModel.SenderName, Mode=OneWay}" />
              <TextBlock
                  VerticalAlignment="Center"
                  FontSize="12.5"
                  Foreground="{ThemeResource SpTextSecondaryBrush}"
                  IsTextSelectionEnabled="True"
                  Text="{x:Bind ViewModel.SenderAddress, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Style="{StaticResource SpCaptionTextStyle}"
                IsTextSelectionEnabled="True"
                MaxLines="2"
                Text="{x:Bind ViewModel.ToLine, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind h:X.VisibleIfText(ViewModel.ToLine), Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource SpCaptionTextStyle}"
                IsTextSelectionEnabled="True"
                MaxLines="2"
                Text="{x:Bind ViewModel.CcLine, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind h:X.VisibleIfText(ViewModel.CcLine), Mode=OneWay}" />
          </StackPanel>

          <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="6">
            <TextBlock
                HorizontalAlignment="Right"
                Style="{StaticResource SpCaptionTextStyle}"
                Text="{x:Bind ViewModel.DateText, Mode=OneWay}" />
            <Border HorizontalAlignment="Right" Style="{StaticResource SpPillStyle}" Background="{ThemeResource SpCardBrush}" BorderBrush="{ThemeResource SpStrokeBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind h:X.HexBrush(ViewModel.AccountColor), Mode=OneWay}" />
                <TextBlock FontSize="11" Foreground="{ThemeResource SpTextSecondaryBrush}" Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" />
                <TextBlock FontSize="11" Foreground="{ThemeResource SpTextTertiaryBrush}" Text="·" />
                <TextBlock FontSize="11" Foreground="{ThemeResource SpTextSecondaryBrush}" Text="{x:Bind ViewModel.FolderName, Mode=OneWay}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Banners -->
      <StackPanel Grid.Row="2" Padding="24,12,24,0" Spacing="8">
        <!-- Conversation: the other messages in this thread; choose one to read or reply to it. -->
        <Expander
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.HasThread, Mode=OneWay}">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon FontSize="14" Foreground="{ThemeResource SpAccentTextBrush}" Glyph="&#xE8BD;" />
              <TextBlock VerticalAlignment="Center" FontSize="13" Text="{x:Bind ViewModel.ThreadSummary, Mode=OneWay}" />
            </StackPanel>
          </Expander.Header>
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.ThreadItems}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="2" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:ThreadEntryViewModel">
                <Button
                    Padding="10,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    Command="{x:Bind OpenCommand}"
                    Opacity="{x:Bind RowOpacity}"
                    Style="{StaticResource SpSubtleButtonStyle}">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource SpAccentBrush}" Visibility="{x:Bind IsUnread}" />
                    <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="{x:Bind h:X.Weight(IsCurrent)}" MaxLines="1" Text="{x:Bind Sender}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" FontSize="12" Foreground="{ThemeResource SpTextTertiaryBrush}" MaxLines="1" Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="3" FontSize="11" Foreground="{ThemeResource SpTextSecondaryBrush}" Glyph="&#xE723;" Visibility="{x:Bind HasAttachments}" />
                    <TextBlock Grid.Column="4" FontSize="11.5" Foreground="{ThemeResource SpTextTertiaryBrush}" Text="{x:Bind DateText}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </Expander>
        <Expander
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontSize="12" Foreground="{ThemeResource SpTextSecondaryBrush}" Glyph="&#xE72E;" />
              <TextBlock FontSize="12" Foreground="{ThemeResource SpTextSecondaryBrush}" Text="{x:Bind ViewModel.SpamCheckSummary, Mode=OneWay}" />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="8">
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasSpamScore, Mode=OneWay}" ToolTipService.ToolTip="Score compared with your threshold (the middle of the bar)">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock FontSize="11" Foreground="{ThemeResource SpTextTertiaryBrush}" Text="Clean" />
              <ProgressBar Grid.Column="1" VerticalAlignment="Center" Maximum="100" Value="{x:Bind ViewModel.SpamScorePercent, Mode=OneWay}" />
              <TextBlock Grid.Column="2" FontSize="11" Foreground="{ThemeResource SpTextTertiaryBrush}" Text="Spam" />
            </Grid>
            <TextBlock Style="{StaticResource SpCaptionTextStyle}" Text="{x:Bind ViewModel.SpamCheckDetail, Mode=OneWay}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.SpamRules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource SpTextSecondaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
        <InfoBar
            Title="{x:Bind ViewModel.SpamTitle, Mode=OneWay}"
            CornerRadius="8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowSpamBanner, Mode=OneWay}"
            Message="{x:Bind ViewModel.SpamDetail, Mode=OneWay}"
            Severity="{x:Bind SpamSeverity(ViewModel.SpamIsSevere), Mode=OneWay}">
          <InfoBar.ActionButton>
            <Button Command="{x:Bind ViewModel.SpamActionCommand}" Content="{x:Bind ViewModel.SpamActionText, Mode=OneWay}" />
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            CornerRadius="8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowFollowUpBanner, Mode=OneWay}"
            Message="{x:Bind ViewModel.FollowUpText, Mode=OneWay}"
            Severity="{x:Bind FollowUpSeverity(ViewModel.FollowUpIsOverdue), Mode=OneWay}">
          <InfoBar.IconSource>
            <FontIconSource Glyph="&#xE7C1;" />
          </InfoBar.IconSource>
          <InfoBar.ActionButton>
            <Button Command="{x:Bind ViewModel.FollowUpCommand}" CommandParameter="Clear" Content="Mark done" />
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            CornerRadius="8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowSnoozeBanner, Mode=OneWay}"
            Message="{x:Bind ViewModel.SnoozeText, Mode=OneWay}"
            Severity="Informational">
          <InfoBar.IconSource>
            <FontIconSource Glyph="&#xE823;" />
          </InfoBar.IconSource>
          <InfoBar.ActionButton>
            <Button Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="Clear" Content="Unsnooze" />
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            CornerRadius="8"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.ShowLocalSpamOpinion, Mode=OneWay}"
            Message="{x:Bind ViewModel.LocalSpamOpinion, Mode=OneWay}"
            Severity="Informational">
          <InfoBar.IconSource>
            <FontIconSource Glyph="&#xEA18;" />
          </InfoBar.IconSource>
          <InfoBar.ActionButton>
            <Button Command="{x:Bind ViewModel.ToggleJunkCommand}" Content="{x:Bind ViewModel.JunkLabel, Mode=OneWay}" />
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            Title="Remote images blocked"
            CornerRadius="8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowRemoteContentBanner, Mode=OneWay}"
            Message="Images from the internet can tell the sender you opened this message."
            Severity="Informational">
          <InfoBar.IconSource>
            <FontIconSource Glyph="&#xE91B;" />
          </InfoBar.IconSource>
          <InfoBar.ActionButton>
            <Button Command="{x:Bind ViewModel.ShowRemoteContentCommand}" Content="Show images" />
          </InfoBar.ActionButton>
        </InfoBar>
      </StackPanel>

      <!-- Attachments -->
      <ScrollViewer
          Grid.Row="3"
          Padding="24,14,24,0"
          HorizontalScrollBarVisibility="Auto"
          HorizontalScrollMode="Auto"
          VerticalScrollBarVisibility="Disabled"
          VerticalScrollMode="Disabled"
          Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel VerticalAlignment="Center" Spacing="4" Visibility="{x:Bind ViewModel.HasSeveralAttachments, Mode=OneWay}">
          <TextBlock FontSize="11" Foreground="{ThemeResource SpTextTertiaryBrush}" Text="{x:Bind ViewModel.AttachmentsSummary, Mode=OneWay}" />
          <Button Click="OnSaveAllClick" Content="Save all…" Style="{StaticResource SpSecondaryButtonStyle}" ToolTipService.ToolTip="Save every attachment into a folder (existing files are never overwritten)" />
        </StackPanel>
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="8" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:AttachmentItemViewModel">
              <Button
                  Width="212"
                  Height="54"
                  Padding="8,6,12,6"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{x:Bind FileName}"
                  Background="{ThemeResource SpCardBrush}"
                  BorderBrush="{ThemeResource SpStrokeBrush}"
                  Command="{x:Bind OpenCommand}"
                  CornerRadius="8"
                  ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind PreviewCommand}" IsEnabled="{x:Bind CanPreview}" Text="Preview" />
                    <MenuFlyoutItem Command="{x:Bind SaveCommand}" Text="Save as…" />
                    <MenuFlyoutItem Command="{x:Bind SaveAllCommand}" Text="Save all attachments…" />
                  </MenuFlyout>
                </Button.ContextFlyout>
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" Background="{ThemeResource SpBadgeBrush}" CornerRadius="6">
                    <FontIcon FontSize="16" Foreground="{ThemeResource SpBadgeTextBrush}" Glyph="{x:Bind Glyph}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontSize="12.5" Foreground="{ThemeResource SpTextPrimaryBrush}" MaxLines="1" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource SpTextTertiaryBrush}" Text="{x:Bind Description}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        </StackPanel>
      </ScrollViewer>

      <!-- Body: a faint, rounded card so HTML and plain-text messages sit naturally inside the glass panel -->
      <Border
          Grid.Row="4"
          Margin="16,14,16,16"
          Padding="16,8,6,0"
          Background="{ThemeResource SpBodyCardBrush}"
          BorderBrush="{ThemeResource SpStrokeBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource SpCornerLarge}">
        <Grid>
          <controls:EmailBodyView x:Name="BodyView" ContentSource="{x:Bind ViewModel.Content, Mode=OneWay}" />
          <ProgressRing
              Width="28"
              Height="28"
              Margin="0,40,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
