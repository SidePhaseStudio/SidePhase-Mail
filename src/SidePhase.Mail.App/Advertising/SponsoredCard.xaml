<?xml version="1.0" encoding="utf-8"?>
<!--
  A small sponsored card in the Dark Glass card style. Always labelled "Sponsored" (and "Test content" for
  demonstration cards); plain text only; no images, animation or autoplay; can be hidden for the session.
  Shown only where the host places it (sidebar footer, empty reading pane) - never inside an email.
-->
<UserControl
    x:Class="SidePhase.Mail.App.Advertising.SponsoredCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border
      x:Name="Card"
      AutomationProperties.LandmarkType="Custom"
      AutomationProperties.LocalizedLandmarkType="Sponsored"
      AutomationProperties.Name="Sponsored content"
      Padding="12,10,8,10"
      Style="{StaticResource SpCardStyle}"
      Visibility="Collapsed">
    <StackPanel Spacing="4">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Style="{StaticResource SpPillStyle}">
            <TextBlock Style="{StaticResource SpPillTextStyle}" Text="Sponsored" />
          </Border>
          <Border x:Name="TestPill" Style="{StaticResource SpPillStyle}" Visibility="Collapsed">
            <TextBlock Style="{StaticResource SpPillTextStyle}" Text="Test content" />
          </Border>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button
              AutomationProperties.Name="Why am I seeing this?"
              Style="{StaticResource SpIconButtonStyle}"
              ToolTipService.ToolTip="Why am I seeing this?">
            <FontIcon FontSize="12" Glyph="&#xE946;" />
            <Button.Flyout>
              <Flyout Placement="Top">
                <StackPanel MaxWidth="300" Spacing="8">
                  <TextBlock Style="{StaticResource SpBodyTextStyle}" FontWeight="SemiBold" Text="About sponsored cards" />
                  <TextBlock Style="{StaticResource SpSecondaryTextStyle}" TextWrapping="Wrap"
                             Text="Sponsored cards help keep SidePhase Mail free. They're the same for everyone: they never use your email, contacts, address or anything else about you, and never appear inside your messages." />
                  <TextBlock x:Name="TestExplanation" Style="{StaticResource SpSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"
                             Text="This one is test content showing how a card looks. It isn't a real advertisement." />
                  <TextBlock Style="{StaticResource SpCaptionTextStyle}" TextWrapping="Wrap"
                             Text="An ad-free upgrade is planned. You can turn previews off in Settings → About." />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button
              AutomationProperties.Name="Hide sponsored content"
              Click="OnHideClick"
              Style="{StaticResource SpIconButtonStyle}"
              ToolTipService.ToolTip="Hide sponsored content until SidePhase Mail restarts">
            <FontIcon FontSize="10" Glyph="&#xE711;" />
          </Button>
        </StackPanel>
      </Grid>
      <TextBlock
          x:Name="HeadlineText"
          Margin="0,2,0,0"
          FontWeight="SemiBold"
          MaxLines="2"
          Style="{StaticResource SpBodyTextStyle}"
          TextTrimming="CharacterEllipsis"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="BodyText"
          MaxLines="3"
          Style="{StaticResource SpCaptionTextStyle}"
          TextTrimming="CharacterEllipsis"
          TextWrapping="Wrap" />
      <Grid Margin="0,2,0,0">
        <TextBlock
            x:Name="AdvertiserText"
            Opacity="0.75"
            Style="{StaticResource SpCaptionTextStyle}"
            TextTrimming="CharacterEllipsis"
            VerticalAlignment="Center" />
        <HyperlinkButton
            x:Name="ActionButton"
            HorizontalAlignment="Right"
            Padding="6,2"
            Click="OnActionClick" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
