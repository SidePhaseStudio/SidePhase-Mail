<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SidePhase.Mail.Infrastructure</RootNamespace>
    <Description>Storage, settings persistence and mail engine implementations for SidePhase Mail.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SidePhase.Mail.Core\SidePhase.Mail.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SidePhase.Mail.Tests" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MicrosoftClientId</_Parameter1>
      <_Parameter2>$(SidePhaseMicrosoftClientId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleClientId</_Parameter1>
      <_Parameter2>$(SidePhaseGoogleClientId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleDesktopClientSecret</_Parameter1>
      <_Parameter2>$(SidePhaseGoogleDesktopClientSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
